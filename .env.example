# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=
# Owners: full control (comma-separated Telegram IDs)
ADMIN_IDS=
# Staff: orders, customers, dashboard, support replies only (optional)
STAFF_IDS=
# Fallback supplier group for packages without their own route
SUPPLIER_CHAT_ID=

STORE_NAME=Nexus Store

# Minutes a supplier group has to act after an order part is delivered to it.
SUPPLIER_TIMEOUT_MINUTES=10

# ── REST API ───────────────────────────────────────────────
# Leave API_KEY blank to use per-store keys only. If enabling the master key,
# set a long random value and keep it private.
API_KEY=
# Exact browser origins allowed to call the API, comma-separated.
# Server-to-server integrations need nothing here. Add "null" only for local file:// testing.
API_CORS_ORIGINS=
# Requests per minute per API key (each client IP gets 5x this).
API_RATE_LIMIT_PER_MINUTE=60

# ── Database ───────────────────────────────────────────────
# Keep DELETE on PythonAnywhere (network storage). WAL is only safe on a local disk.
SQLITE_JOURNAL_MODE=DELETE
# The bot task writes one backup a day here and keeps the newest N.
# BACKUP_DIR=/home/you/TELEGRAM BOT/nexus_bot/backups
BACKUP_KEEP_DAYS=7
