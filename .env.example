# ─── Bot Configuration ───────────────────────────────────────────────
BOT_TOKEN=your-bot-token-from-botfather

# ─── Admin Configuration ─────────────────────────────────────────────
# Comma-separated Telegram user IDs of admins
ADMIN_IDS=123456789,987654321

# ─── Supplier Configuration ──────────────────────────────────────────
# Telegram chat ID of the supplier group (negative number for groups)
SUPPLIER_CHAT_ID=-1001234567890

# ─── Store Configuration ─────────────────────────────────────────────
STORE_NAME=Nexus Store
CURRENCY=USDT
BINANCE_ID=your-binance-pay-id

# ─── PIN Authentication ───────────────────────────────────────────────
# Set this via /setpin admin command after first launch
# NEVER put plain PIN here — it is stored as a bcrypt hash in the database

# Max failed PIN attempts before lockout
MAX_PIN_ATTEMPTS=5
# Lockout duration in minutes
LOCKOUT_MINUTES=30
# Session expiry in hours (0 = never expires)
SESSION_HOURS=0

# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./nexus_bot.db

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
